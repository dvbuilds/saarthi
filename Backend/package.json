  "type": "module",
  "scripts": {
    "test": "echo \"No automated test suite yet — placeholder so CI doesn't fail on a missing command\" && exit 0",
    "start": "node --import ./tracing.js server.js",
    "worker": "node --import ./tracing.js worker.js",
    "dev": "node --import ./tracing.js server.js",
    "dev:worker": "node --import ./tracing.js worker.js",
    "dev:full": "concurrently -n API,WORKER -c blue,green \"npm run dev\" \"npm run dev:worker\"",
    "start:combined": "concurrently -n API,WORKER -c blue,green \"npm run start\" \"npm run worker\"",
    "loadtest": "node loadtest/run.js"
  },
